# ─── Banco de dados (Neon) ─────────────────────────────────────────────
# Criadas automaticamente ao conectar o Neon pela aba "Storage" da Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ─── Arquivos (Vercel Blob, store PRIVADO) ──────────────────────────────
# Criadas automaticamente ao conectar um Blob store pela aba "Storage".
# Stores novos usam OIDC (BLOB_STORE_ID); stores antigos usam BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ─── Acesso ao painel ─────────────────────────────────────────────────
ADMIN_PASSWORD=
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# ─── Rotina diária (Vercel Cron) ──────────────────────────────────────
# A Vercel envia "Authorization: Bearer $CRON_SECRET" automaticamente.
CRON_SECRET=

# ─── Cora (Integração Direta / mTLS) ──────────────────────────────────
# stage = testes | production = real
CORA_ENV=stage
CORA_CLIENT_ID=
# Conteúdo dos arquivos certificate.pem e private-key.key (PEM completo ou em base64)
CORA_CERTIFICATE=
CORA_PRIVATE_KEY=
# Token secreto incluído na URL do webhook (?token=...). Gere com: openssl rand -hex 24
CORA_WEBHOOK_SECRET=

# ─── WhatsApp (Evolution API v2) ──────────────────────────────────────
EVOLUTION_API_URL=https://evolution.seudominio.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
