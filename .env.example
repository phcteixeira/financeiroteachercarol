# ─── Banco de dados (Neon) ─────────────────────────────────────────────
# Criadas automaticamente ao conectar o Neon pela aba "Storage" da Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ─── Arquivos (Vercel Blob, store PRIVADO) ──────────────────────────────
# Criadas automaticamente ao conectar um Blob store pela aba "Storage".
# Stores novos usam OIDC (BLOB_STORE_ID); stores antigos usam BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ─── Acesso ao painel ─────────────────────────────────────────────────
ADMIN_PASSWORD=
# Gere com: openssl rand -base64 48
AUTH_SECRET=

# ─── Rotina diária (Vercel Cron) ──────────────────────────────────────
# A Vercel envia "Authorization: Bearer $CRON_SECRET" automaticamente.
CRON_SECRET=

# Chave que criptografa as credenciais da Cora/Evolution guardadas no banco.
# Gere com: openssl rand -base64 48  (se ausente, usa AUTH_SECRET)
# ATENÇÃO: se trocar, será preciso cadastrar as credenciais de novo no painel.
ENCRYPTION_KEY=

# ─── Cora e Evolution ─────────────────────────────────────────────────
# As credenciais são cadastradas no painel: Configurações → Integrações.
# (Opcional) As variáveis abaixo só são usadas se nada estiver cadastrado no painel.
# CORA_ENV=stage
# CORA_CLIENT_ID=
# CORA_CERTIFICATE=
# CORA_PRIVATE_KEY=
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=

# Token secreto incluído na URL do webhook (?token=...). Gere com: openssl rand -hex 24
CORA_WEBHOOK_SECRET=

